# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
POSTGRES_PASSWORD=postgres
ALLOW_REGISTRATION=true

# Chat model
LLM_MODEL=gemini-3.5-flash-lite

# Embeddings: "gemini" (default) or "huggingface".
# EMBEDDING_DIM must match the model: 768 for Gemini (as configured here),
# 384 for sentence-transformers/all-MiniLM-L6-v2.
# Changing provider/dimension later requires re-creating the chunks table and re-uploading docs.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Hugging Face cross-encoder reranker (build with INSTALL_HF=true)
INSTALL_HF=false
RERANKER_ENABLED=false
